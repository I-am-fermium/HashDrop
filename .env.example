# HashDrop Environment Configuration
# Copy this file to .env.local and configure as needed

# Solana RPC Endpoints
# These can be overridden with your own RPC provider

# Devnet RPC URL (default: Solana Devnet)
NEXT_PUBLIC_SOLANA_DEVNET_RPC=https://api.devnet.solana.com

# Mainnet RPC URL
# IMPORTANT: You MUST configure a custom Mainnet RPC URL.
# The application will NOT fall back to the public Solana Mainnet RPC.
# 
# Recommended providers (all have free tiers):
# - Helius: https://docs.helius.dev
# - QuickNode: https://www.quicknode.com
# - Alchemy: https://docs.alchemy.com
# - SolanaFM: https://solana.fm/docs/rpc
#
# Example with Helius (replace YOUR_API_KEY with your actual key):
# NEXT_PUBLIC_SOLANA_MAINNET_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
#
# Example with QuickNode:
# NEXT_PUBLIC_SOLANA_MAINNET_RPC=https://your-endpoint.quiknode.pro/your-api-key/
#
# Example with Alchemy:
# NEXT_PUBLIC_SOLANA_MAINNET_RPC=https://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Network Selection (default: devnet)
# This is set via UI, but can be pre-configured
# HASHDROP_NETWORK=devnet